{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vice Tracker data",
  "type": "object",
  "required": ["version", "updatedAt", "categories", "cheats"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump by 1 on every publish. The app only downloads a file whose version is higher than the one it has."
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of this update, YYYY-MM-DD. Shown in the app's Settings."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "items"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "spoiler": { "type": "boolean", "description": "true hides the name until completed, when the player has spoilers hidden." }
              }
            }
          }
        }
      }
    },
    "cheats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "effect", "codes"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 },
          "details": { "type": "string" },
          "codes": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "playstation": { "type": "string", "minLength": 1 },
              "xbox": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Permanent. Players' progress and saved items are stored against it: never rename or reuse one."
    }
  }
}
