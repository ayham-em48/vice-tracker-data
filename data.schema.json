{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vice Tracker data",
  "type": "object",
  "required": ["version", "updatedAt", "categories", "cheats"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "number",
      "minimum": 1,
      "description": "Bump by 0.1 on every publish (2.1, 2.2, ... 2.9, 3.0). The app only downloads a file whose version is higher than the one it has."
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of this update, YYYY-MM-DD. Shown in the app's Settings."
    },
    "cards": {
      "type": "array",
      "description": "Home screen stacked cards. Optional: without it the app shows Favorites, one card per category, then Cheats.",
      "items": {
        "type": "object",
        "required": ["id", "type", "order"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id", "description": "Stable card id; never rename once shipped." },
          "type": { "enum": ["favorites", "category", "cheats"] },
          "categoryId": { "$ref": "#/$defs/id", "description": "Required for category cards. Must match a categories[].id." },
          "order": { "type": "integer", "description": "Lower shows higher. Favorites is always first." },
          "status": { "enum": ["live", "partial", "coming_soon", "hidden"], "default": "live" },
          "notice": { "type": "string", "maxLength": 80, "description": "Banner at the top of a partial card's list." },
          "comingSoonText": { "type": "string", "maxLength": 60, "description": "Subtitle on a coming_soon card. Default \"Coming soon\"." },
          "title": { "type": "string", "minLength": 1, "description": "Overrides the default card title." },
          "badge": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 12, "description": "Empty means no badge." },
              "style": { "enum": ["new", "hot", "info"], "default": "info" },
              "expiresAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD. The badge disappears after this date." }
            }
          }
        },
        "if": { "properties": { "type": { "const": "category" } } },
        "then": { "required": ["categoryId"] }
      }
    },
    "ads": {
      "type": "object",
      "description": "Remote ad config. Missing or invalid values fall back to the defaults.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "nativeEvery": { "type": "integer", "minimum": 4, "default": 6, "description": "One native ad every N list items. Minimum 4." },
        "listBanner": { "type": "boolean", "default": true },
        "detailBanner": { "type": "boolean", "default": true }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "items"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "spoiler": { "type": "boolean", "description": "true hides the name until completed, when the player has spoilers hidden." },
                "character": { "type": "string", "minLength": 1, "description": "Playable character(s) for this item, e.g. \"Michael, Franklin\"." },
                "giver": { "type": "string", "minLength": 1, "description": "Who gives this side quest." },
                "count": { "type": "integer", "minimum": 1, "description": "How many of this collectible there are to find." }
              }
            }
          }
        }
      }
    },
    "cheats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "effect", "codes"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 },
          "details": { "type": "string" },
          "codes": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "playstation": { "type": "string", "minLength": 1 },
              "xbox": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Permanent. Players' progress and saved items are stored against it: never rename or reuse one."
    }
  }
}
